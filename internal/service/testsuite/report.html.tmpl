<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Multimo 评测报告</title>
<style>
:root {
  --ground: #f4f6f8; --paper: #ffffff; --ink: #17202a; --muted: #6b7684; --rule: #e2e6eb; --hair: #eceff3;
  --pass: #2e7d4f; --pass-bg: #e5f2ea; --fail: #c2412d; --fail-bg: #fbe9e5; --chart: #2b63b5; --magenta: #c2185b;
  --sans: "Source Sans 3", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", "Helvetica Neue", Arial, sans-serif;
  --figures: var(--sans);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --ground: #151d25; --paper: #1d2731; --ink: #e6ebef; --muted: #96a3af; --rule: #34414d; --hair: #28333e;
    --pass: #7cc495; --pass-bg: #1d3426; --fail: #ec8a74; --fail-bg: #3a231d; --chart: #8db5e6; --magenta: #ec7fb3;
  }
}
:root[data-theme="dark"] {
  --ground: #151d25; --paper: #1d2731; --ink: #e6ebef; --muted: #96a3af; --rule: #34414d; --hair: #28333e;
  --pass: #7cc495; --pass-bg: #1d3426; --fail: #ec8a74; --fail-bg: #3a231d; --chart: #8db5e6; --magenta: #ec7fb3;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--ground); color: var(--ink); font: 15px/1.6 var(--sans); }
main { max-width: 1080px; margin: 0 auto; padding: 36px 16px 80px; }
header { background: var(--paper); border: 1px solid var(--rule); border-radius: 14px; padding: 22px 24px; margin-bottom: 28px; }
h1 { font-size: 28px; line-height: 1.2; margin: 0 0 12px; font-weight: 600; }
h2 { font-size: 20px; margin: 40px 0 6px; font-weight: 600; }
h3 { font-size: 16px; margin: 22px 0 8px; font-weight: 600; }
.meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px 24px; margin: 0; }
.meta dt { font-size: 12px; color: var(--muted); }
.meta dd { margin: 0; overflow-wrap: anywhere; }
.tally { margin-top: 16px; font-size: 15px; }
.tally strong { font: 600 26px var(--figures); font-variant-numeric: tabular-nums; margin-right: 4px; }
.def { color: var(--muted); font-size: 14px; max-width: 76ch; margin: 4px 0 14px; }
.scroll { overflow-x: auto; margin: 0 0 8px; border: 1px solid var(--rule); border-radius: 14px; }
table { border-collapse: collapse; width: 100%; background: var(--paper); font-size: 14px; }
th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--hair); vertical-align: top; }
th { font-weight: 400; font-size: 12px; color: var(--muted); border-bottom: 1px solid var(--rule); white-space: nowrap; }
td.n, th.n { text-align: right; white-space: nowrap; }
.nw { white-space: nowrap; }
td.n { font: 16px var(--figures); font-variant-numeric: tabular-nums; }
tr:last-child td { border-bottom: 0; }
tr.total td { border-top: 1px solid var(--rule); font-weight: 600; }
tr.aux td { color: var(--muted); }
.summary td:first-child { font-weight: 600; }
.summary tr.aux td:first-child { font-weight: 400; }
.v { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 13px; font-weight: 600; white-space: nowrap; }
.v.ok { color: var(--pass); background: var(--pass-bg); }
.v.no { color: var(--fail); background: var(--fail-bg); }
.v.ref { color: var(--muted); font-weight: 400; }
.note { color: var(--muted); font-size: 13px; }
.file { font-size: 13px; overflow-wrap: anywhere; }
.err { border-left: 3px solid var(--fail); background: var(--fail-bg); padding: 8px 12px; margin: 12px 0; font-size: 14px; }
details { margin: 12px 0; }
summary { cursor: pointer; color: var(--chart); font-size: 14px; }
.ans { max-width: 46ch; }
.hit { color: var(--magenta); font-weight: 600; }
.figures { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: 14px; margin: 10px 0 16px; overflow: hidden; }
.figures div { background: var(--paper); padding: 10px 12px; }
.figures span { display: block; font-size: 12px; color: var(--muted); }
.figures b { font: 600 22px var(--figures); font-variant-numeric: tabular-nums; }
footer { margin-top: 56px; color: var(--muted); font-size: 13px; }
@media print { body { background: #fff; } details { display: block; } details > summary { display: none; } }
@media (max-width: 640px) { h1 { font-size: 23px; } main { padding-top: 20px; } }
</style>
</head>
<body>
<main>
<header>
  <h1>Multimo 评测报告</h1>
  <dl class="meta">
    <div><dt>生成时间</dt><dd>{{time .}}</dd></div>
    <div><dt>版本</dt><dd>{{.Version}}</dd></div>
    <div><dt>耗时</dt><dd>{{f 0 .DurationSec}} 秒</dd></div>
    {{range models .Models}}<div><dt>{{modelName (index . 0)}}</dt><dd>{{index . 1}}</dd></div>{{end}}
  </dl>
  {{$t := primary .Metrics}}
  <p class="tally"><strong>{{index $t 0}}/{{index $t 1}}</strong> 项核心指标达标</p>
</header>

{{range $k, $v := .Errors}}<div class="err"><b>{{$k}}</b> 未完成：{{$v}}</div>{{end}}

<section>
<h2>指标总览</h2>
<p class="def">核心指标对应赛题要求，参考指标用于解释结果。各项真值均来自数据集标注、GPS 记录或文档原文，不使用系统自身的输出。</p>
<div class="scroll"><table class="summary">
<thead><tr><th>指标</th><th class="n">结果</th><th>目标</th><th>结论</th><th>说明</th></tr></thead>
<tbody>
{{range .Metrics}}<tr{{if not .Primary}} class="aux"{{end}}>
  <td>{{.Name}}</td><td class="n">{{.Display}}</td><td class="nw">{{.Target}}</td>
  <td>{{if .Primary}}<span class="v {{if .Pass}}ok{{else}}no{{end}}">{{verdict .Pass}}</span>{{else}}<span class="v ref">参考</span>{{end}}</td>
  <td class="note">{{.Note}}</td>
</tr>{{end}}
</tbody></table></div>
</section>

{{with .Formats}}
<section>
<h2>数据类型覆盖</h2>
<p class="def">{{def $ "formats"}}</p>
<div class="scroll"><table>
<thead><tr><th>类型</th><th>格式</th><th class="n">解析成功</th><th class="n">失败</th></tr></thead>
<tbody>{{range .Rows}}<tr><td>{{.Type}}</td><td class="file">{{.Format}}</td><td class="n">{{.Ready}}</td><td class="n">{{.Failed}}</td></tr>{{end}}
<tr class="total"><td>{{.Types}} 种类型</td><td>{{.Formats}} 种格式</td><td></td><td></td></tr></tbody>
</table></div>
{{if .Failed}}<p class="note">解析失败：{{range .Failed}}<span class="file">{{.}}</span> {{end}}</p>{{end}}
</section>
{{end}}

{{with .Keyframe}}
<section>
<h2>关键帧自动标注一致性</h2>
<p class="def">{{def $ "keyframe_consistency"}}</p>
<div class="scroll"><table>
<thead><tr><th>视频</th><th class="n">关键帧</th><th class="n">已评测</th><th class="n">TP</th><th class="n">FP</th><th class="n">FN</th><th class="n">准确率</th><th class="n">召回率</th><th class="n">F1</th><th class="n">类别 Jaccard</th><th class="n">语义余弦</th></tr></thead>
<tbody>{{range .Videos}}<tr><td class="file">{{.ID}}</td><td class="n">{{.Keyframes}}</td><td class="n">{{.Evaluated}}</td><td class="n">{{.Match.TP}}</td><td class="n">{{.Match.FP}}</td><td class="n">{{.Match.FN}}</td><td class="n">{{pct .Precision}}</td><td class="n">{{pct .Recall}}</td><td class="n">{{pct .F1}}</td><td class="n">{{f 3 .Jaccard}}</td><td class="n">{{f 3 .Cosine}}</td></tr>{{end}}
<tr class="total"><td>合计</td><td class="n">{{.Keyframes}}</td><td></td><td class="n">{{.Match.TP}}</td><td class="n">{{.Match.FP}}</td><td class="n">{{.Match.FN}}</td><td class="n">{{pct .Match.Precision}}</td><td class="n">{{pct .Match.Recall}}</td><td class="n">{{pct .F1}}</td><td class="n">{{f 3 .Jaccard}}</td><td class="n">{{f 3 .Cosine}}</td></tr></tbody>
</table></div>
{{if .Skipped}}<p class="note">跳过：{{range .Skipped}}{{.}}；{{end}}</p>{{end}}
</section>
{{end}}

{{with .Detection}}
<section>
<h2>目标识别</h2>
<p class="def">{{def $ "detection"}}</p>
<div class="figures">
  <div><span>图片</span><b>{{.Images}}</b></div>
  <div><span>准确率（类别一致）</span><b>{{pct .Precision}}</b></div>
  <div><span>漏检率（类别一致）</span><b>{{pct .MissRate}}</b></div>
  <div><span>准确率（同大类）</span><b>{{pct .GroupPrec}}</b></div>
  <div><span>漏检率（同大类）</span><b>{{pct .GroupMissRate}}</b></div>
  <div><span>准确率（不排除不可见目标）</span><b>{{pct .RawPrecision}}</b></div>
</div>
<div class="scroll"><table>
<thead><tr><th>口径</th><th class="n">TP</th><th class="n">FP</th><th class="n">FN</th><th class="n">忽略</th><th class="n">准确率</th><th class="n">召回率</th><th class="n">漏检率</th></tr></thead>
<tbody>
<tr><td>类别一致</td><td class="n">{{.Exact.TP}}</td><td class="n">{{.Exact.FP}}</td><td class="n">{{.Exact.FN}}</td><td class="n">{{.Exact.Ignored}}</td><td class="n">{{pct .Exact.Precision}}</td><td class="n">{{pct .Exact.Recall}}</td><td class="n">{{pct .Exact.MissRate}}</td></tr>
<tr><td>同大类</td><td class="n">{{.Grouped.TP}}</td><td class="n">{{.Grouped.FP}}</td><td class="n">{{.Grouped.FN}}</td><td class="n">{{.Grouped.Ignored}}</td><td class="n">{{pct .Grouped.Precision}}</td><td class="n">{{pct .Grouped.Recall}}</td><td class="n">{{pct .Grouped.MissRate}}</td></tr>
</tbody></table></div>
<h3>按类别</h3>
<div class="scroll"><table>
<thead><tr><th>类别</th><th class="n">可见标注</th><th class="n">预测</th><th class="n">准确率</th><th class="n">召回率</th></tr></thead>
<tbody>{{range .PerClass}}<tr><td>{{.Label}}</td><td class="n">{{.GT}}</td><td class="n">{{.Pred}}</td><td class="n">{{pct .Precision}}</td><td class="n">{{pct .Recall}}</td></tr>{{end}}</tbody>
</table></div>
</section>
{{end}}

{{with .Geo}}
<section>
<h2>空间对齐</h2>
<p class="def">{{def $ "geo"}}</p>
<div class="figures">
  <div><span>已定位</span><b>{{.Located}}/{{.Total}}</b></div>
  <div><span>中位误差</span><b>{{f 0 .Visual.Median}} m</b></div>
  <div><span>平均误差</span><b>{{f 0 .Visual.Mean}} m</b></div>
  <div><span>P90</span><b>{{f 0 .Visual.P90}} m</b></div>
  <div><span>&lt; 100 m</span><b>{{pct .Within100}}</b></div>
  <div><span>&lt; 250 m</span><b>{{pct .Within250}}</b></div>
</div>
{{with .DJI}}<p>DJI 视频：{{.Keyframes}} 个关键帧，{{.FromTelemetry}} 个由飞行记录定位（{{.Alignment}}），与独立插值的最大偏差 <span class="file">{{f 2 .MaxDeviationM}} m</span>。</p>{{end}}
<details><summary>逐张误差（{{len .Items}} 张）</summary>
<div class="scroll"><table>
<thead><tr><th>照片</th><th>定位来源</th><th class="n">误差</th></tr></thead>
<tbody>{{range .Items}}<tr><td class="file">{{.Image}}</td><td>{{.Source}}</td><td class="n">{{meters .ErrorM}}</td></tr>{{end}}</tbody>
</table></div></details>
</section>
{{end}}

{{with .Retrieval}}
<section>
<h2>检索</h2>
<p class="def">{{def $ "retrieval_precision"}}</p>
<p class="def">{{def $ "retrieval_recall"}}</p>
<div class="figures">
  <div><span>准确率</span><b>{{pct .Precision}}</b></div>
  <div><span>查全率</span><b>{{pct .Recall}}</b></div>
  <div><span>P@5 / P@10</span><b>{{f 2 .P5}} / {{f 2 .P10}}</b></div>
  <div><span>R@5 / R@10</span><b>{{f 2 .R5}} / {{f 2 .R10}}</b></div>
  <div><span>延迟中位 / P90</span><b>{{f 1 .Latency.Median}}/{{f 1 .Latency.P90}}<small> ms</small></b></div>
</div>
<div class="scroll"><table>
<thead><tr><th>类型</th><th class="n">数量</th><th class="n">准确率</th><th class="n">查全率</th><th class="n">判为相关的精确率</th><th class="n">判为相关的查全率</th></tr></thead>
<tbody>{{range .ByType}}<tr><td>{{.Type}}</td><td class="n">{{.N}}</td><td class="n">{{pct .Precision}}</td><td class="n">{{pct .Recall}}</td><td class="n">{{pct .SetP}}</td><td class="n">{{pct .SetR}}</td></tr>{{end}}
<tr class="total"><td>全部</td><td class="n">{{len .Queries}}</td><td class="n">{{pct .Precision}}</td><td class="n">{{pct .Recall}}</td><td class="n">{{pct .SetP}}</td><td class="n">{{pct .SetR}}</td></tr></tbody>
</table></div>
<details><summary>逐条结果（{{len .Queries}} 条，绿色为相关结果）</summary>
<div class="scroll"><table>
<thead><tr><th>ID</th><th>Query</th><th class="n">相关数</th><th class="n">准确率</th><th class="n">查全率</th><th>前 10 名</th></tr></thead>
<tbody>{{range .Queries}}<tr><td class="file">{{.ID}}</td><td>{{.Query}}{{if .Error}}<div class="note">{{.Error}}</div>{{end}}</td><td class="n">{{.Relevant}}</td><td class="n">{{pct .Precision}}</td><td class="n">{{pct .Recall}}</td>
<td class="file">{{range $i, $p := .Top}}{{if $i}}，{{end}}{{if hit $p}}<span class="hit">{{base (strip $p)}}</span>{{else}}{{base $p}}{{end}}{{end}}</td></tr>{{end}}</tbody>
</table></div></details>
</section>
{{end}}

{{with .QA}}
<section>
<h2>智能问答</h2>
<p class="def">{{def $ "qa"}}</p>
<div class="scroll"><table>
<thead><tr><th>类别</th><th class="n">数量</th><th class="n">正确</th><th class="n">准确率</th></tr></thead>
<tbody>{{range .ByCategory}}<tr><td>{{.Category}}</td><td class="n">{{.N}}</td><td class="n">{{.Correct}}</td><td class="n">{{pct .Accuracy}}</td></tr>{{end}}
<tr class="total"><td>全部</td><td class="n">{{.Total}}</td><td class="n">{{.Correct}}</td><td class="n">{{pct .Accuracy}}</td></tr></tbody>
</table></div>
<p class="note">平均评分 {{f 2 .MeanGrade}} / 2，回答延迟中位 {{f 1 .Latency.Median}} ms。</p>
<details><summary>逐题结果（{{len .Items}} 题）</summary>
<div class="scroll"><table>
<thead><tr><th>ID</th><th>问题</th><th>参考答案</th><th>系统回答</th><th class="n">判定</th></tr></thead>
<tbody>{{range .Items}}<tr><td class="file">{{.ID}}<div class="note">{{.Category}}</div></td><td>{{.Question}}</td><td class="ans note">{{.Reference}}</td><td class="ans">{{.Answer}}{{if .Error}}<div class="note">{{.Error}}</div>{{end}}</td>
<td class="n"><span class="v {{if .Correct}}ok{{else}}no{{end}}">{{if .Correct}}正确{{else}}错误{{end}}</span><div class="note">{{if eq .Method "geo"}}{{meters .GeoErrorM}}{{else}}{{grade .Grade}}{{end}}</div></td></tr>{{end}}</tbody>
</table></div></details>
</section>
{{end}}

<footer>由 multimo testsuite 生成。全部明细见同目录的 test_report.json。</footer>
</main>
</body>
</html>
